# cp .env.example .env  후 값을 채운다. .env 는 커밋되지 않는다.

# ---------------------------------------------------------------- 데이터
# jsonl / .f16 / .posted 가 들어 있는 루트
DATA_ROOT=openalex_2021-2025_postprocessed
YEARS=2021,2022,2023,2024,2025

# 전처리를 다시 돌릴 때만 필요한 OpenAlex parquet 덤프 위치
PARQUET_ROOT=OpenAlex_20260330_integrated_parsed_parquet

# ---------------------------------------------------------------- Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=openalex_2021-2025_abs
# QDRANT_API_KEY=

# 세그먼트 개수. 램 오버헤드가 (인덱스 개수 x 세그먼트 개수) 로 곱해진다.
SEGMENT_NUMBER=16

# ------------------------------------------------------- 임베딩 / 리랭커
BGE_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANKER_BATCH=32

# 검색 기본값: 벡터로 50개 -> 중복 제거 -> 리랭커 -> 10개
SEARCH_CANDIDATES=50
SEARCH_LIMIT=10
# 제목 키워드 검색 기본 개수
KEYWORD_LIMIT=5

# ------------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000

# 비워두면 실행할 때마다 새 키가 생성된다. 여기에 적어두면 고정된다.
# 아무 값이나 되지만 추측하기 어려운 문자열로.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SEARCH_API_KEY=

# ------------------------------------------------------------- Cloudflare
# 비우면 퀵 터널(*.trycloudflare.com). 주소가 실행할 때마다 바뀐다.
# 고정 주소가 필요하면 named tunnel 을 만들고 그 이름을 여기에.
#   cloudflared tunnel login
#   cloudflared tunnel create openalex
#   cloudflared tunnel route dns openalex search.example.com
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARED_BIN=cloudflared
