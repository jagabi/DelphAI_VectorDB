# cp .env.example .env  후 값을 채운다. .env 는 커밋되지 않는다.

# ---------------------------------------------------------------- 데이터
# jsonl / .f16 / .posted 가 들어 있는 루트
DATA_ROOT=openalex_2021-2025_postprocessed
YEARS=2021,2022,2023,2024,2025

# 전처리를 다시 돌릴 때만 필요한 OpenAlex parquet 덤프 위치
PARQUET_ROOT=OpenAlex_20260330_integrated_parsed_parquet

# ---------------------------------------------------------------- Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=openalex_2021-2025_abs
# QDRANT_API_KEY=

# 세그먼트 개수. 램 오버헤드가 (인덱스 개수 x 세그먼트 개수) 로 곱해진다.
SEGMENT_NUMBER=16

# ------------------------------------------------------- 임베딩 / 리랭커
BGE_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512

# forward 배치. GPU 메모리에 직결된다. A6000 48GB 면 아래가 여유롭고,
# nvidia-smi 로 사용률이 90% 안 나오면 더 올려도 된다.
EMBED_BATCH_CUDA=128
EMBED_BATCH_CPU=16
RERANKER_BATCH_CUDA=64
RERANKER_BATCH_CPU=8

# Ampere(A6000) TF32 matmul. 추론 정확도 손실은 무시할 수준이고 눈에 띄게 빠르다.
USE_TF32=1

# 이 프로세스가 쓸 VRAM 상한(GiB). 0 = 제한 없음.
# 같은 GPU 에 gemma 같은 다른 모델을 같이 올릴 때 여기서 몫을 나눈다.
# 상한을 넘으면 OOM 이 나지만 배치를 절반으로 줄여 재시도하므로 죽지는 않는다.
# 상한에 맞춰 배치 기본값도 자동으로 낮아진다.
#
#   가중치만 2.4 GiB (bge-m3 1.2 + reranker 1.2, fp16)
#   4  : 동작함. 배치가 작아 리랭킹이 조금 느려진다. 여유가 얇다
#   6  : 4 와 배치는 같지만 여유가 생겨 안정적
#   8  : 배치가 2배로 올라간다
#   0  : 제한 없음
#
# 주의: CUDA 컨텍스트(0.3~0.6 GiB)는 이 상한 바깥이라
#       nvidia-smi 에는 상한보다 그만큼 더 잡힌다.
GPU_MEMORY_GIB=4

# 요청 처리 후 캐싱 할당자가 붙들고 있는 VRAM 을 드라이버에 돌려준다.
# 조금 느려지지만 옆에서 도는 모델이 그만큼 쓸 수 있다.
RELEASE_CACHE=1

# 검색 기본값: 벡터로 50개 -> 중복 제거 -> 리랭커 -> 10개
SEARCH_CANDIDATES=50
SEARCH_LIMIT=10
# 제목 키워드 검색 기본 개수
KEYWORD_LIMIT=5

# ------------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000

# 비워두면 실행할 때마다 새 키가 생성된다. 여기에 적어두면 고정된다.
# 아무 값이나 되지만 추측하기 어려운 문자열로.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
OPENALEX_VDB_API_KEY=

# ------------------------------------------------------------------ 터널
# 비우면 퀵 터널. *.trycloudflare.com 주소가 실행할 때마다 바뀐다.
# (Cloudflare 설계상 퀵 터널 주소는 고정할 수 없다)
#
# 주소를 고정하려면 named tunnel 을 만들고 그 이름을 여기 적는다.
# 본인 소유 도메인이 Cloudflare 에 있어야 한다. 준비는 한 번만:
#   cloudflared tunnel login
#   cloudflared tunnel create openalex
#   cloudflared tunnel route dns openalex search.example.com
TUNNEL_NAME=
CLOUDFLARED_BIN=cloudflared
